---
import PanForm from './PanForm.astro';
import { OWNABLE } from '../lib/calc.js';
const { preset = '' } = Astro.props;
const btn = 'inline-flex h-12 items-center justify-center gap-2 rounded-xl border border-edge bg-card px-4 text-base font-semibold hover:border-brand focus-visible:border-brand';
const field = 'mt-1 block h-12 w-full rounded-xl border border-edge bg-paper px-3 text-base outline-none focus:border-brand focus:ring-2 focus:ring-brand/30';
---
<section id="tool" data-preset={preset} aria-label="Cake pan converter" class="rounded-2xl border border-line bg-card p-4 sm:shadow-[6px_6px_0_0_var(--line)] sm:p-6">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div role="group" aria-label="Units" class="inline-flex rounded-xl border border-line p-1">
      <button type="button" data-unit-btn="in" aria-pressed="true" class="h-11 rounded-lg px-4 text-sm font-semibold aria-pressed:bg-brand aria-pressed:text-white">Inches</button>
      <button type="button" data-unit-btn="cm" aria-pressed="false" class="h-11 rounded-lg px-4 text-sm font-semibold aria-pressed:bg-brand aria-pressed:text-white">Centimeters</button>
    </div>
    <button type="button" id="swap" class={btn}>Swap pans <span aria-hidden="true">&#8646;</span></button>
  </div>

  <noscript><p class="rounded-xl border border-line bg-brand-soft p-4">This tool needs JavaScript. Turn it on in your browser to use the converter.</p></noscript>

  <div id="msg" class="mb-4 hidden rounded-xl border border-line bg-brand-soft p-4 text-base" role="status"></div>

  <div class="grid items-start gap-4 md:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_19rem]">
    <PanForm id="a" title="Pan in the recipe" hint="(what it says)" />
    <PanForm id="b" title="Pan you will use" hint="(what you have)" />

    <div id="result" class="result-tile scroll-mt-20 rounded-2xl border border-line bg-brand-soft p-4 md:col-span-2 lg:col-span-1">
      <p class="text-sm font-semibold uppercase tracking-wide text-muted">Multiply the recipe by</p>
      <p id="scale" class="font-mono text-6xl font-extrabold leading-none tabular-nums text-brand-ink sm:text-7xl">1.00&times;</p>
      <p id="say-scale" class="mt-3 text-lg font-semibold" aria-live="polite"></p>
      <p id="scale-text" class="mt-1 text-base" aria-live="polite"></p>
      <p id="fill-warn" class="mt-2 hidden rounded-lg border border-line bg-card p-3 text-sm font-medium" role="status"></p>
      <p id="depth-note" class="mt-2 hidden text-sm text-muted"></p>
      <figure class="m-0 mt-4">
        <svg id="draw" viewBox="0 0 440 210" class="h-auto w-full rounded-xl bg-card" role="img" aria-label="The two pans drawn to the same scale"></svg>
        <figcaption id="draw-cap" class="mt-1 text-xs text-muted">Both pans are drawn to the same scale.</figcaption>
      </figure>
      <table class="mt-4 w-full text-left text-sm">
        <thead class="text-xs uppercase tracking-wide text-muted"><tr><th class="pb-1 font-semibold"></th><th class="pb-1 font-semibold">Recipe pan</th><th class="pb-1 font-semibold">Your pan</th></tr></thead>
        <tbody class="font-mono tabular-nums">
          <tr class="border-t border-line"><th class="py-2 pr-2 font-sans font-medium text-muted">Area</th><td id="area-a"></td><td id="area-b"></td></tr>
          <tr class="border-t border-line"><th class="py-2 pr-2 font-sans font-medium text-muted">Pan capacity</th><td id="vol-a"></td><td id="vol-b"></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <details id="owned-box" class="mt-6 rounded-xl border border-line bg-paper/60 p-4">
    <summary class="cursor-pointer text-lg font-bold">Which of my pans will work?</summary>
    <p class="mt-2 text-sm text-muted">Tick the pans you own. We list the ones within about 10% of the recipe pan's volume, best first. Your ticks stay in this browser only.</p>
    <fieldset class="mt-3">
      <legend class="sr-only">Pans I own</legend>
      <div class="grid grid-cols-2 gap-x-4 sm:grid-cols-3">
        {OWNABLE.map((o) => (
          <label class="flex min-h-11 items-center gap-2 text-base"><input type="checkbox" data-own={o.id} class="h-5 w-5 accent-[var(--brand)]" /> {o.label}</label>
        ))}
      </div>
    </fieldset>
    <ul id="owned-list" class="mt-3 space-y-2" aria-live="polite"></ul>
  </details>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div>
      <h2 class="text-lg font-bold">Bake time and temperature</h2>
      <div class="mt-2 grid grid-cols-2 gap-3">
        <div>
          <div class="flex h-8 items-center"><label class="text-xs font-semibold uppercase tracking-wide text-muted" for="mins">Recipe bake time (min)</label></div>
          <input id="mins" type="text" inputmode="numeric" placeholder="30" autocomplete="off" class={`${field} font-mono tabular-nums`} />
        </div>
        <div>
          <div class="flex h-8 items-center justify-between gap-2">
            <label class="text-xs font-semibold uppercase tracking-wide text-muted" for="temp">Oven</label>
            <div role="group" aria-label="Oven temperature unit" class="inline-flex rounded-lg border border-line p-0.5">
              <button type="button" data-temp-btn="F" aria-pressed="true" class="h-7 min-w-9 rounded-md px-2 text-xs font-semibold aria-pressed:bg-brand aria-pressed:text-white">&deg;F</button>
              <button type="button" data-temp-btn="C" aria-pressed="false" class="h-7 min-w-9 rounded-md px-2 text-xs font-semibold aria-pressed:bg-brand aria-pressed:text-white">&deg;C</button>
            </div>
          </div>
          <input id="temp" type="text" inputmode="numeric" placeholder="350" autocomplete="off" class={`${field} font-mono tabular-nums`} />
        </div>
      </div>
      <p class="mt-3 text-sm text-muted">Rule of thumb: deeper batter, lower the oven 25&deg;F (15&deg;C) and add 5 to 15 minutes. Thinner batter, same oven, check early.</p>
      <div id="bake" class="mt-3 space-y-2 text-base"></div>
    </div>
    <div>
      <h2 class="text-lg font-bold">Scale your ingredients</h2>
      <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-muted" id="round-l">Round amounts to</span>
        <div role="group" aria-labelledby="round-l" class="inline-flex rounded-lg border border-line p-0.5">
          <button type="button" data-round-btn="fine" aria-pressed="true" class="h-9 rounded-md px-3 text-sm font-semibold aria-pressed:bg-brand aria-pressed:text-white">Eighths</button>
          <button type="button" data-round-btn="quarter" aria-pressed="false" class="h-9 rounded-md px-3 text-sm font-semibold aria-pressed:bg-brand aria-pressed:text-white">Quarters</button>
        </div>
      </div>
      <label class="mt-2 block text-xs font-semibold uppercase tracking-wide text-muted" for="recipe">Paste the ingredient list, one per line</label>
      <textarea id="recipe" rows="7" placeholder={'1 1/2 cups flour\n3/4 cup sugar\n2 large eggs\n1 tsp baking powder'}
        class="mt-1 block max-h-[28rem] min-h-40 w-full resize-y [field-sizing:content] rounded-xl border border-edge bg-paper p-3 font-mono text-base outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"></textarea>
      <button type="button" id="example" class="mt-2 text-sm font-medium text-brand-ink underline underline-offset-4">Try an example</button>
      <h3 id="scaled-h" class="mt-4 hidden text-sm font-semibold uppercase tracking-wide text-muted">Scaled for your pan</h3>
      <ul id="scaled" class="mt-2 space-y-1 font-mono text-base"></ul>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <button type="button" id="copy" class="inline-flex h-12 items-center justify-center rounded-xl bg-brand px-5 text-base font-bold text-white hover:opacity-90">Copy result</button>
    <button type="button" id="copy-link" class={btn}>Copy link</button>
    <button type="button" id="print" class={btn}>Print</button>
    <span id="copy-status" class="self-center text-sm text-muted" role="status"></span>
  </div>
</section>


<div id="bar" class="fixed inset-x-0 bottom-0 z-20 hidden border-t border-line bg-card/95 px-4 py-2 backdrop-blur md:hidden">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3">
    <p class="text-sm text-muted">Multiply by <span id="bar-scale" class="ml-1 font-mono text-2xl font-extrabold tabular-nums text-brand-ink"></span></p>
    <div class="flex gap-2">
      <button type="button" id="bar-jump" class="inline-flex h-11 items-center rounded-xl border border-edge px-3 text-sm font-semibold">See result</button>
      <button type="button" id="bar-copy" class="inline-flex h-11 items-center rounded-xl bg-brand px-3 text-sm font-bold text-white">Copy</button>
    </div>
  </div>
</div>

<script>
  import {
    SHAPES, PRESETS, IN_TO_CM, RECIPE_URL_LIMIT, LIMITS, defaultPan, panName, panProblem, convert, bakeGuide,
    scaleRecipe, fmtNum, dec, toQuery, bundtRadius, parseSize, describeScale, areaText, volumeText,
    sayScale, fillWarning, matchPans, setRounding,
  } from '../lib/calc.js';

  type Pan = { shape: string; a: number; b: number; depth: number; count: number };
  type State = { A: Pan; B: Pan; unit: 'in' | 'cm'; tempUnit: 'F' | 'C'; temp: number; minutes: number; recipe: string };
  const el = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const NS = 'http://www.w3.org/2000/svg';
  const EXAMPLE = '1 1/2 cups all-purpose flour\n1 cup sugar\n1/2 cup (1 stick) butter\n2 large eggs\n1 (8 oz) package cream cheese\n1 tsp vanilla';

  // Sizes live in state in inches at full precision. The boxes are written from state and only read when typed in.
  const state: State = { A: defaultPan('round'), B: { ...defaultPan('round'), a: 9 }, unit: 'in', tempUnit: 'F', temp: 0, minutes: 0, recipe: '' };

  const toUnit = (inches: number) => (state.unit === 'cm' ? inches * IN_TO_CM : inches);
  const fromUnit = (v: number) => (state.unit === 'cm' ? v / IN_TO_CM : v);
  const shown = (inches: number) => fmtNum(toUnit(inches), state.unit === 'cm' ? 1 : 2);
  const presetsFor = (shape: string): any[] => (PRESETS as any)[state.unit][shape];
  const link = () => `${location.origin}${location.pathname}#${toQuery(state)}`;
  const mk = (tag: string, attrs: Record<string, string | number>) => {
    const e = document.createElementNS(NS, tag);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  };
  const key = (id: 'a' | 'b') => (id === 'a' ? 'A' : 'B') as 'A' | 'B';

  // Select the preset that matches the pan, or "Custom size".
  function syncPreset(id: 'a' | 'b') {
    const p = state[key(id)];
    const i = presetsFor(p.shape).findIndex((o) => Math.abs(o[1] - p.a) < 0.01 && Math.abs((o[2] || 0) - (p.b || 0)) < 0.01);
    el<HTMLSelectElement>(`${id}-preset`).value = i >= 0 ? String(i) : 'custom';
  }

  function renderPan(id: 'a' | 'b') {
    const p = state[key(id)];
    const shape = (SHAPES as any)[p.shape];
    el<HTMLSelectElement>(`${id}-shape`).value = p.shape;
    const sel = el<HTMLSelectElement>(`${id}-preset`);
    sel.innerHTML = '';
    for (const [i, o] of presetsFor(p.shape).entries()) {
      const op = document.createElement('option');
      op.value = String(i); op.textContent = o[0];
      sel.appendChild(op);
    }
    const custom = document.createElement('option');
    custom.value = 'custom'; custom.textContent = 'Custom size';
    sel.appendChild(custom);
    syncPreset(id);
    const two = shape.dims.length === 2;
    const bundt = p.shape === 'bundt';
    el(`${id}-a-l`).textContent = bundt ? shape.dims[0] : `${shape.dims[0]} (${state.unit})`;
    el(`${id}-b-l`).textContent = `${shape.dims[1] || ''} (${state.unit})`;
    el(`${id}-b-wrap`).style.display = two ? '' : 'none';
    el(`${id}-d-wrap`).style.display = bundt ? 'none' : '';
    el<HTMLInputElement>(`${id}-a`).value = bundt ? fmtNum(p.a, 1) : shown(p.a);
    if (two) el<HTMLInputElement>(`${id}-b`).value = shown(p.b);
    el<HTMLInputElement>(`${id}-d`).value = shown(p.depth);
    el<HTMLInputElement>(`${id}-n`).value = String(p.count);
    document.querySelectorAll(`[data-pan="${id}"] [data-unit]`).forEach((e) => (e.textContent = `(${state.unit})`));
  }

  // Read one box that the person typed in. Other boxes keep the exact stored values.
  function readField(id: 'a' | 'b', f: string) {
    const p = state[key(id)];
    const v = parseSize(el<HTMLInputElement>(`${id}-${f}`).value);
    if (f === 'a') p.a = p.shape === 'bundt' ? v : fromUnit(v);
    else if (f === 'b') p.b = fromUnit(v);
    else if (f === 'd') p.depth = fromUnit(v);
    else p.count = v;
  }

  function panGeometry(p: Pan): [number, number] {
    if (p.shape === 'round') return [p.a, p.a];
    if (p.shape === 'bundt') { const d = 2 * bundtRadius(p); return [d, d]; }
    if (p.shape === 'square') return [p.a, p.a];
    return [Math.max(p.a, p.b), Math.min(p.a, p.b)];
  }

  function drawPan(p: Pan, cx: number, cy: number, ppi: number) {
    const g = mk('g', { class: 'text-brand-ink' });
    const style = { fill: 'currentColor', 'fill-opacity': 0.14, stroke: 'currentColor', 'stroke-width': 2.5 };
    const [w, l] = panGeometry(p);
    if (p.shape === 'round') g.appendChild(mk('circle', { cx, cy, r: (w / 2) * ppi, ...style }));
    else if (p.shape === 'bundt') {
      g.appendChild(mk('circle', { cx, cy, r: (w / 2) * ppi, ...style }));
      g.appendChild(mk('circle', { cx, cy, r: 0.3 * (w / 2) * ppi, fill: 'var(--brand-soft)', stroke: 'currentColor', 'stroke-width': 2 }));
    } else {
      g.appendChild(mk('rect', { x: cx - (w * ppi) / 2, y: cy - (l * ppi) / 2, width: w * ppi, height: l * ppi, rx: p.shape === 'loaf' ? 6 : 4, ...style }));
    }
    return g;
  }

  function drawing() {
    const svg = el('draw');
    svg.innerHTML = '';
    const [aw, ah] = panGeometry(state.A), [bw, bh] = panGeometry(state.B);
    const ppi = Math.min(170 / Math.max(aw, bw), 140 / Math.max(ah, bh));
    const sides: [Pan, number, string][] = [[state.A, 110, 'Recipe pan'], [state.B, 330, 'Your pan']];
    for (const [p, cx, cap] of sides) {
      // Several pans are drawn as a short stack, up to three.
      const n = Math.min(p.count, 3);
      for (let i = n - 1; i >= 0; i--) svg.appendChild(drawPan(p, cx + (i - (n - 1) / 2) * 8, 85 - (i - (n - 1) / 2) * 8, ppi));
      const t = mk('text', { x: cx, y: 176, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 15, 'font-weight': 600 });
      t.textContent = panName(p, state.unit, false);
      const t2 = mk('text', { x: cx, y: 197, 'text-anchor': 'middle', fill: 'currentColor', 'fill-opacity': 0.7, 'font-size': 13 });
      t2.textContent = p.count > 1 ? `${cap}, ${p.count} pans` : cap;
      svg.appendChild(t); svg.appendChild(t2);
    }
    svg.style.color = 'var(--ink)';
    svg.setAttribute('aria-label', `Recipe pan: ${panName(state.A, state.unit)}. Your pan: ${panName(state.B, state.unit)}. Both drawn to the same scale.`);
    el('draw-cap').textContent = 'Both pans are drawn to the same scale.' + (state.A.count > 1 || state.B.count > 1 ? ' Several pans are shown as a stack.' : '') + (state.A.shape === 'bundt' || state.B.shape === 'bundt' ? ' Bundt outlines are approximate.' : '');
  }

  // Name the problem so the person knows which box to fix.
  const range = (min: number, max: number) => (state.unit === 'cm' ? `${fmtNum(min * IN_TO_CM, 1)} to ${fmtNum(max * IN_TO_CM, 0)} cm` : `${min} to ${max} inches`);
  function problems(): string[] {
    const out: string[] = [];
    for (const [which, p] of [['the recipe pan', state.A], ['your pan', state.B]] as [string, Pan][]) {
      const bad = panProblem(p);
      if (bad === 'size') out.push(p.shape === 'bundt'
        ? `Check the size of ${which}. Use the cups printed on the pan, from ${LIMITS.minCups} to ${LIMITS.cups}.`
        : `Check the size of ${which}. Use a number such as 8 or 8 1/2, from ${range(LIMITS.minSize, LIMITS.size)}.`);
      if (bad === 'depth') out.push(`Enter a depth for ${which}, from ${range(LIMITS.minDepth, LIMITS.depth)}.`);
      if (bad === 'count') out.push(`Number of pans for ${which} must be a whole number from 1 to ${LIMITS.count}.`);
    }
    return out;
  }

  let lastText = '';
  let valid = false;
  function update() {
    state.minutes = Math.round(parseSize(el<HTMLInputElement>('mins').value)) || 0;
    state.temp = Math.round(parseSize(el<HTMLInputElement>('temp').value)) || 0;
    state.recipe = el<HTMLTextAreaElement>('recipe').value;

    const msg = el('msg'), result = el('result');
    const bad = problems();
    valid = bad.length === 0;
    syncBar();
    if (!valid) {
      msg.textContent = bad.join(' ');
      msg.classList.remove('hidden');
      result.style.opacity = '0.35';
      el('scale').textContent = '–';
      el('say-scale').textContent = '';
      el('fill-warn').classList.add('hidden');
      lastText = '';
      syncUrl();
      return;
    }
    msg.classList.add('hidden');
    result.style.opacity = '';

    const r = convert(state.A, state.B);
    const scaleTxt = `${r.scale.toFixed(2)}×`;
    el('scale').textContent = scaleTxt;
    el('bar-scale').textContent = scaleTxt;
    const scaleText = describeScale(r, state.A, state.B, state.unit);
    const say = sayScale(r.scale);
    const warn = fillWarning(state.B) || '';
    el('say-scale').textContent = say;
    el('scale-text').textContent = scaleText;
    el('fill-warn').textContent = warn;
    el('fill-warn').classList.toggle('hidden', !warn);
    const note = el('depth-note');
    const flat = state.A.shape !== 'bundt' && state.B.shape !== 'bundt';
    const depthDiffers = flat && Math.abs(state.A.depth / state.B.depth - 1) > 0.15;
    note.textContent = depthDiffers ? 'The two pans have different depths, so this compares volume. To compare by area only, set both depths to the same value.' : '';
    note.classList.toggle('hidden', !depthDiffers);
    const areaOf = (v: number, p: Pan) => (p.shape === 'bundt' ? 'n/a' : areaText(v, state.unit));
    el('area-a').textContent = areaOf(r.areaA, state.A);
    el('area-b').textContent = areaOf(r.areaB, state.B);
    el('vol-a').textContent = volumeText(r.volA, state.unit);
    el('vol-b').textContent = volumeText(r.volB, state.unit);

    drawing();
    renderOwnedList();

    const g = bakeGuide(r, state.A, state.B, state.minutes, state.temp, state.tempUnit);
    const bake = el('bake');
    bake.innerHTML = '';
    const tl = state.tempUnit === 'C' ? '°C' : '°F';
    const head = document.createElement('p');
    head.className = 'rounded-xl bg-brand-soft p-3 font-semibold';
    const parts = [];
    if (g.temp) parts.push(`Bake at ${g.temp}${tl}`);
    if (g.range) parts.push(`start checking at ${g.range[0]} min, expect done by ${g.range[1]} min`);
    head.textContent = parts.length ? parts.join(', ') + '.' : 'Enter the recipe bake time and oven temperature for exact numbers.';
    bake.appendChild(head);
    for (const t of g.lines as string[]) { const p = document.createElement('p'); p.className = 'text-muted'; p.textContent = t; bake.appendChild(p); }

    const ul = el('scaled');
    ul.innerHTML = '';
    const copyLines: string[] = [];
    for (const l of scaleRecipe(state.recipe, r.scale) as { text: string; note: string }[]) {
      if (!l.text) continue;
      const li = document.createElement('li');
      li.textContent = l.text;
      copyLines.push(l.text.trim());
      if (l.note) {
        const n = document.createElement('div');
        n.className = 'font-sans text-sm text-muted';
        n.textContent = l.note;
        li.appendChild(n);
        copyLines.push(`  (${l.note})`);
      }
      ul.appendChild(li);
    }
    el('scaled-h').classList.toggle('hidden', copyLines.length === 0);

    lastText = [
      `Cake pan conversion: ${panName(state.A, state.unit)} to ${panName(state.B, state.unit)}`,
      `Multiply the recipe by ${r.scale.toFixed(2)}x. ${say} ${scaleText}`,
      ...(warn ? [warn] : []),
      `Area: ${el('area-a').textContent} to ${el('area-b').textContent}. Capacity: ${el('vol-a').textContent} to ${el('vol-b').textContent}.`,
      head.textContent || '',
      ...g.lines,
      ...(copyLines.length ? ['', 'Scaled ingredients:', ...copyLines] : []),
      '', link(),
    ].join('\n');
    syncUrl();
  }

  function syncUrl() {
    try { history.replaceState(null, '', `${location.pathname}#${toQuery(state)}`); } catch { /* ignore */ }
    // Remember the last pair for a repeat visit. Only the pans, never the recipe.
    if (valid) try { localStorage.setItem('pans', toQuery({ ...state, recipe: '', minutes: 0, temp: 0 })); } catch { /* ignore */ }
  }

  // "Which of my pans will work?"
  let owned: string[] = [];
  try { owned = JSON.parse(localStorage.getItem('owned') || '[]').filter((x: unknown) => typeof x === 'string'); } catch { owned = []; }
  function renderOwnedList() {
    const ul = el('owned-list');
    ul.innerHTML = '';
    if (!valid || !owned.length) return;
    const all = matchPans(state.A, owned);
    const near = all.filter((m: any) => m.near);
    const shownList = near.length ? near : all.slice(0, 1);
    if (!near.length) {
      const li = document.createElement('li');
      li.className = 'text-sm text-muted';
      li.textContent = 'None of your pans is within 10% of the recipe pan. The closest one is:';
      ul.appendChild(li);
    }
    for (const m of shownList as any[]) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-card px-3 py-2';
      const t = document.createElement('span');
      t.textContent = `${m.label}: multiply by ${m.scale.toFixed(2)}`;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'h-11 rounded-lg border border-edge px-3 text-sm font-semibold hover:border-brand';
      b.textContent = 'Use this pan';
      b.addEventListener('click', () => { state.B = { shape: m.pan.shape, a: m.pan.a, b: m.pan.b, depth: m.pan.depth, count: m.count }; renderPan('b'); update(); });
      li.appendChild(t); li.appendChild(b);
      ul.appendChild(li);
    }
  }
  document.querySelectorAll<HTMLInputElement>('[data-own]').forEach((box) => {
    box.checked = owned.includes(box.dataset.own!);
    box.addEventListener('change', () => {
      owned = [...document.querySelectorAll<HTMLInputElement>('[data-own]')].filter((c) => c.checked).map((c) => c.dataset.own!);
      try { localStorage.setItem('owned', JSON.stringify(owned)); } catch { /* ignore */ }
      renderOwnedList();
    });
  });
  if (owned.length) (el('owned-box') as HTMLDetailsElement).open = true;

  function setRoundBtn(mode: 'fine' | 'quarter') {
    setRounding(mode);
    document.querySelectorAll<HTMLElement>('[data-round-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.roundBtn === mode)));
  }

  function flash(text: string) {
    const s = el('copy-status');
    s.textContent = text;
    setTimeout(() => { if (s.textContent === text) s.textContent = ''; }, 2500);
  }
  async function copy(text: string, ok: string) {
    try { await navigator.clipboard.writeText(text); flash(ok); }
    catch {
      const t = document.createElement('textarea');
      t.value = text; document.body.appendChild(t); t.select();
      try { document.execCommand('copy'); flash(ok); } catch { flash('Copy failed. Select the text and copy it.'); }
      t.remove();
    }
  }
  const copyResult = () => (lastText ? copy(lastText, 'Result copied.') : flash('Enter both pan sizes first.'));

  function setUnit(u: 'in' | 'cm') {
    state.unit = u;
    document.querySelectorAll<HTMLElement>('[data-unit-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.unitBtn === u)));
    renderPan('a'); renderPan('b');
  }
  function setTempUnit(u: 'F' | 'C') {
    state.tempUnit = u;
    document.querySelectorAll<HTMLElement>('[data-temp-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tempBtn === u)));
    el<HTMLInputElement>('temp').placeholder = u === 'C' ? '175' : '350';
  }

  function wire(id: 'a' | 'b') {
    const k = key(id);
    el(`${id}-shape`).addEventListener('change', (e) => {
      const shape = (e.target as HTMLSelectElement).value;
      state[k] = { ...defaultPan(shape, state.unit), count: state[k].count };
      renderPan(id); update();
    });
    el(`${id}-preset`).addEventListener('change', (e) => {
      const v = (e.target as HTMLSelectElement).value;
      if (v === 'custom') return;
      const o = presetsFor(state[k].shape)[+v];
      state[k].a = o[1]; state[k].b = o[2] || 0;
      renderPan(id); update();
    });
    for (const f of ['a', 'b', 'd', 'n']) {
      el(`${id}-${f}`).addEventListener('input', () => { readField(id, f); syncPreset(id); update(); });
    }
  }

  // Load pans and settings from the address after the # sign.
  function loadFrom(qs: string): boolean {
    const q = new URLSearchParams(qs);
    const unit = q.get('u') === 'cm' ? 'cm' : 'in';
    const a = dec(q.get('a'), unit), b = dec(q.get('b'), unit);
    if (!a || !b) return false;
    state.A = a; state.B = b;
    el<HTMLInputElement>('mins').value = q.get('m') || '';
    el<HTMLInputElement>('temp').value = q.get('t') || '';
    el<HTMLTextAreaElement>('recipe').value = q.get('r') || '';
    setTempUnit(q.get('tu') === 'c' ? 'C' : 'F');
    setRoundBtn(q.get('f') === '4' ? 'quarter' : 'fine');
    setUnit(unit);
    return true;
  }
  const loadHash = () => loadFrom(location.hash.slice(1));
  const loadSaved = () => { try { return loadFrom(localStorage.getItem('pans') || ''); } catch { return false; } };

  // Show the "Multiply by" bar on a phone while the answer is off screen.
  const seen = { tool: false, result: false };
  function syncBar() {
    el('bar').classList.toggle('hidden', !(valid && seen.tool && !seen.result));
  }
  const watch = (id: string, name: 'tool' | 'result') => new IntersectionObserver((es) => { seen[name] = es[es.length - 1].isIntersecting; syncBar(); }).observe(el(id));

  // start
  if (!loadHash() && !loadFrom(el('tool').dataset.preset || '') && !loadSaved()) { setTempUnit('F'); setUnit('in'); }
  wire('a'); wire('b');
  document.querySelectorAll<HTMLElement>('[data-unit-btn]').forEach((btn) => btn.addEventListener('click', () => { setUnit(btn.dataset.unitBtn as 'in' | 'cm'); update(); }));
  document.querySelectorAll<HTMLElement>('[data-temp-btn]').forEach((btn) => btn.addEventListener('click', () => { setTempUnit(btn.dataset.tempBtn as 'F' | 'C'); update(); }));
  for (const id of ['mins', 'temp', 'recipe']) el(id).addEventListener('input', update);
  el('example').addEventListener('click', () => { el<HTMLTextAreaElement>('recipe').value = EXAMPLE; update(); });
  el('swap').addEventListener('click', () => { [state.A, state.B] = [state.B, state.A]; renderPan('a'); renderPan('b'); update(); });
  document.querySelectorAll<HTMLElement>('[data-round-btn]').forEach((btn) => btn.addEventListener('click', () => { setRoundBtn(btn.dataset.roundBtn as 'fine' | 'quarter'); update(); }));
  el('copy').addEventListener('click', copyResult);
  el('bar-copy').addEventListener('click', copyResult);
  el('bar-jump').addEventListener('click', () => el('result').scrollIntoView({ behavior: 'smooth', block: 'start' }));
  el('copy-link').addEventListener('click', () => copy(link(), state.recipe.length > RECIPE_URL_LIMIT ? `Link copied. It holds the first ${RECIPE_URL_LIMIT} characters of the list.` : 'Link copied.'));
  el('print').addEventListener('click', () => window.print());
  // A pasted share link or the back button changes only the address. Load it when it differs from what is on screen.
  window.addEventListener('hashchange', () => {
    if (location.hash.slice(1) !== toQuery(state) && loadHash()) update();
  });
  watch('tool', 'tool'); watch('result', 'result');
  update();
</script>
